# Example Volvo Developer API Credentials
# Copy this file to .env.secrets and fill in your keys from developer.volvocars.com
# .env.secrets is ignored by git and will NEVER be committed.

VOLVO_CLIENT_ID="your_volvo_client_id_here"
VOLVO_CLIENT_SECRET="your_volvo_client_secret_here"
VOLVO_VCC_API_KEY="your_vcc_api_key_here"
