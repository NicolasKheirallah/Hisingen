# Example Volvo Developer API Credentials
# Copy this file to .env.secrets and fill in your keys from developer.volvocars.com
# .env.secrets is ignored by git and will NEVER be committed.
#
# Scripts/inject-secrets.sh reads these and generates
# Sources/Hisingen/Services/API/GeneratedVolvoSecrets.swift, which is itself
# git-ignored — the XOR masking there is trivially reversible, so a committed
# copy would publish the live credentials. In CI the same three values come
# from GitHub Actions secrets of the same name.

VOLVO_CLIENT_ID="your_volvo_client_id_here"
VOLVO_CLIENT_SECRET="your_volvo_client_secret_here"
VOLVO_VCC_API_KEY="your_vcc_api_key_here"

# Only needed to run the opt-in live probe tests in
# Tests/HisingenTests/Integration/LiveVolvoIntegrationTests.swift, which also
# require HISINGEN_ENABLE_VOLVO_PROBES to be set. Those probes send grants the
# client is not entitled to; every rejection counts towards a PingFederate
# per-client lockout, so leave them off unless you are actively debugging auth.
VOLVO_VIN="your_volvo_vin_here"
POLESTAR_LOGIN="your_volvo_id_email_here"
POLESTAR_PASS="your_volvo_id_password_here"
POLESTAR_VIN="your_polestar_vin_here"

# Optional. Static AppSync-style key Hisingen sends as `x-api-key` when calling Polestar's
# public `GetCarImages` GraphQL endpoint. Baked into the official Polestar app, not
# user-specific — the same value is published in plaintext by other open-source Polestar
# clients, so Hisingen ships a working default in BuiltinPolestarSecrets.swift and nobody
# needs to set this to get vehicle images working. Only set it here if Polestar rotates the
# key and you need to override the built-in default before a new Hisingen release ships.
POLESTAR_IMAGE_API_KEY="your_polestar_public_image_api_key_here"

# Polestar Developer Portal (EU Data Act) M2M Credentials
# Obtain from https://developer.polestar.com
# POLESTAR_ACCOUNT_ID is your Developer Account UUID (sent as x-client-id header)
POLESTAR_ACCOUNT_ID="your_polestar_account_uuid_here"
POLESTAR_CLIENT_ID="your_polestar_client_id_here"
POLESTAR_CLIENT_SECRET="your_polestar_client_secret_here"


# Home Charging live checks (Tibber and NexBlue). Personal credentials, not app keys:
# Scripts/inject-secrets.sh does NOT read these and nothing here is compiled into the app,
# because a value baked into a build ships to everyone who installs it. In the app they are
# typed into Settings, Electricity (Tibber) and Settings, Home Charging (NexBlue) and kept in
# the macOS Keychain. Put them in .env.secrets only for opt-in local live tests that read the
# process environment, the way the Volvo and Polestar probes above do.
#
# TIBBER_ACCESS_TOKEN is a personal access token from https://developer.tibber.com.
# NEXBLUE_USERNAME and NEXBLUE_PASSWORD are the myNexBlue account login.
TIBBER_ACCESS_TOKEN="your_tibber_personal_access_token_here"
NEXBLUE_USERNAME="your_mynexblue_email_here"
NEXBLUE_PASSWORD="your_mynexblue_password_here"

# PERIFIC_USERNAME and PERIFIC_PASSWORD are the Perific (formerly Enegic) app login. Same rules as
# above: typed into Settings, Home Charging, kept in the Keychain, never compiled in.
PERIFIC_USERNAME="your_perific_email_here"
PERIFIC_PASSWORD="your_perific_password_here"
