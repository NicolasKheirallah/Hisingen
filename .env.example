# Example Volvo Developer API Credentials
# Copy this file to .env.secrets and fill in your keys from developer.volvocars.com
# .env.secrets is ignored by git and will NEVER be committed.
#
# Scripts/inject-secrets.sh reads these and generates
# Sources/Hisingen/Services/API/GeneratedVolvoSecrets.swift, which is itself
# git-ignored — the XOR masking there is trivially reversible, so a committed
# copy would publish the live credentials. In CI the same three values come
# from GitHub Actions secrets of the same name.

VOLVO_CLIENT_ID="your_volvo_client_id_here"
VOLVO_CLIENT_SECRET="your_volvo_client_secret_here"
VOLVO_VCC_API_KEY="your_vcc_api_key_here"

# Only needed to run the opt-in live probe tests in
# Tests/HisingenTests/Integration/LiveVolvoIntegrationTests.swift, which also
# require HISINGEN_ENABLE_VOLVO_PROBES to be set. Those probes send grants the
# client is not entitled to; every rejection counts towards a PingFederate
# per-client lockout, so leave them off unless you are actively debugging auth.
VOLVO_VIN="your_volvo_vin_here"
POLESTAR_LOGIN="your_volvo_id_email_here"
POLESTAR_PASS="your_volvo_id_password_here"
POLESTAR_VIN="your_polestar_vin_here"

# Static AppSync-style key Hisingen sends as `x-api-key` when calling Polestar's public
# `GetCarImages` GraphQL endpoint. Baked into the official Polestar app, not user-specific —
# but still build-injected rather than committed in plaintext, same as the Volvo credentials
# above. Without it, vehicle-image fetching is silently disabled rather than broken outright.
POLESTAR_IMAGE_API_KEY="your_polestar_public_image_api_key_here"
